# ─── 캐시 제어 ───────────────────────────────────────────────
<IfModule mod_headers.c>
  # index.html — 항상 최신 버전 확인
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # 콘텐츠 해시가 붙은 정적 에셋 (JS/CSS) — 1년 캐싱
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 이미지/폰트 — 30일 캐싱
  <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # API 경로 — 절대 캐싱 금지
  <FilesMatch "\.php$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, private"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

# ─── URL 라우팅 ───────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Authorization 헤더를 PHP에 전달
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # sitemap.xml → sitemap.php
  RewriteRule ^sitemap\.xml$ /sitemap.php [L]

  # 물리적 파일/디렉토리는 직접 서빙 (wp-content, wp-admin, assets 등)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # WordPress REST API / 관리자
  RewriteRule ^wp-json(/.*)?$ /index.php [L]
  RewriteRule ^wp-admin(/.*)?$ /index.php [L]
  RewriteRule ^wp-login\.php$ /index.php [L]

  # React SPA 경로 (명시적으로 지정)
  RewriteRule ^$ /index.html [L]
  RewriteRule ^ingredients-technology(/.*)?$ /index.html [L]
  RewriteRule ^blog(/.*)?$ /index.html [L]
  RewriteRule ^podcast(/.*)?$ /index.html [L]
  RewriteRule ^products(/.*)?$ /index.html [L]
  RewriteRule ^youth-reset(/.*)?$ /index.html [L]
  RewriteRule ^about(/.*)?$ /index.html [L]
  RewriteRule ^mypage(/.*)?$ /index.html [L]

  # 나머지 모든 경로 → WordPress
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.php [L]
</IfModule>
